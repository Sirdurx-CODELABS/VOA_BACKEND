{
  "name": "voa-backend",
  "version": "1.0.0",
  "description": "VOA System - Organization Management Platform API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "set NODE_OPTIONS=--max-old-space-size=512 && nodemon server.js",
    "seed": "set NODE_OPTIONS=--max-old-space-size=512 && node src/utils/seed.js",
    "migrate-orgs": "set NODE_OPTIONS=--max-old-space-size=512 && node src/utils/migrate-orgs.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:ai": "jest --forceExit --detectOpenHandles src/ai/__tests__"
  },
  "keywords": [
    "voa",
    "organization",
    "management",
    "api"
  ],
  "author": "VOA System",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@huggingface/inference": "^4.13.22",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "joi": "^17.12.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.2.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "openai": "^6.45.0",
    "socket.io": "^4.8.3",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.0"
  }
}
